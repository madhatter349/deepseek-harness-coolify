# ─────────────────────────────────────────────────────────────────────────────
# DeepSeek Harness — runtime environment
#
# Copy to `.env` for docker-compose, or paste the same pairs into the Coolify
# application's Environment Variables. Credentials live ONLY here / in the
# Coolify env store — never in the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Layout (persistent volume) ───────────────────────────────────────────────
# Sessions, config, credentials and agent state all live under DSH_HOME.
# Repositories and working files live under DSH_WORKSPACE_DIR.
DSH_HOME=/data/dsh-home
DSH_WORKSPACE_DIR=/data/workspace
PORT=3080

# Public HTTPS origin. Used only to render the first-visit URL written to
# $DSH_HOME/last-login-url.txt; the server itself never binds this hostname.
DSH_PUBLIC_URL=https://dsh.example.com

# ── Browser-trust fence ──────────────────────────────────────────────────────
# Comma-separated public authorities (host or host:port, no scheme). Must
# contain the Coolify domain, because Traefik forwards it as the Host header.
# Loopback is always trusted and needs no entry.
DSH_TRUSTED_HOSTS=dsh.example.com
# Signed browser-session cookie lifetime. Existing browsers stay logged in
# across restarts for this long.
DSH_COOKIE_MAX_AGE_DAYS=365

# ── Model gateway (OpenAI-compatible) ────────────────────────────────────────
# Any endpoint that speaks OpenAI Chat Completions: the DeepSeek official API,
# a private CheapestInference/queue gateway, LiteLLM, vLLM, OpenRouter, ...
#
# Example A — private CheapestInference gateway:
#   DSH_LLM_BASE_URL=https://inference.example.com/v1
#   DSH_LLM_API_KEY=<the gateway PROXY_API_KEY>
#
# Example B — DeepSeek official API:
#   DSH_LLM_BASE_URL=https://api.deepseek.com/v1
#   DSH_LLM_API_KEY=sk-...
#
# The model catalogue itself lives in the profile patch
# ($DSH_HOME/profiles/web/cordis.patch.yml), seeded from
# deploy/profile.seed.patch.yml; add or remove models there.
DSH_LLM_BASE_URL=https://inference.example.com/v1
DSH_LLM_API_KEY=replace-with-your-gateway-token
DSH_LLM_CONTEXT_WINDOW=131072
DSH_LLM_MAX_OUTPUT_TOKENS=8192

# Additional sources seeded for the same model families (see
# deploy/profile.seed.patch.yml): AMD Radeon and OpenCode Zen. ClinePass is
# commented out there until its account balance is positive.
DSH_AMD_API_KEY=replace-with-amd-radeon-key
DSH_OPENCODE_API_KEY=replace-with-opencode-go-key
# DSH_CLINE_API_KEY=replace-with-cline-key

# ── Privacy ──────────────────────────────────────────────────────────────────
# OTel delivery off; DeepSeek session-log upload off. Set
# DSH_SESSION_LOG_UPLOAD=1 only when deliberately using the official
# DeepSeek adapter and accepting that session logs ride along with requests.
DSH_TELEMETRY_DISABLED=1
DSH_SESSION_LOG_UPLOAD=0

# ── Local docker-compose only (ignored by Coolify) ───────────────────────────
DSH_HOST_BIND=127.0.0.1
DSH_HOST_PORT=13080
